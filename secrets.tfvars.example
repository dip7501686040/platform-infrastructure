# Copy this file to secrets.floci.tfvars / secrets.aws.tfvars and fill
# in real values. Both are gitignored — never commit actual secrets.
#
# For the Floci pass, dummy values are fine (that environment is
# disposable and never runs real workloads). For the AWS pass, use real
# generated values — see the plan's Secrets section for how these reach
# Kubernetes (they are NOT applied by Terraform itself).

jwt_secret             = ""
postgres_password      = ""
rabbitmq_password      = ""
anthropic_api_key      = ""
openai_api_key         = ""
smtp_password          = ""
stripe_secret_key      = ""
stripe_webhook_secret  = ""
google_client_secret   = ""

# Must be a real GitHub PAT even for the Floci pass — Jenkins uses it to
# push tag-bump commits, seeded into its credential store at boot.
github_push_username  = ""
github_push_token     = ""
