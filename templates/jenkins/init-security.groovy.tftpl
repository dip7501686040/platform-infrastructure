import jenkins.model.*
import hudson.security.*
import com.cloudbees.plugins.credentials.*
import com.cloudbees.plugins.credentials.domains.*
import com.cloudbees.plugins.credentials.impl.*

def instance = Jenkins.get()

def hudsonRealm = new HudsonPrivateSecurityRealm(false)
hudsonRealm.createAccount("admin", "${admin_password}")
instance.setSecurityRealm(hudsonRealm)

def strategy = new FullControlOnceLoggedInAuthorizationStrategy()
strategy.setAllowAnonymousRead(false)
instance.setAuthorizationStrategy(strategy)

instance.save()

def credsStore = SystemCredentialsProvider.getInstance().getStore()
def domain = Domain.global()

def upsertCredential = { id, description, username, secret ->
  def existing = credsStore.getCredentials(domain).find { it.id == id }
  if (existing != null) {
    credsStore.removeCredentials(domain, existing)
  }
  credsStore.addCredentials(domain, new UsernamePasswordCredentialsImpl(
    CredentialsScope.GLOBAL, id, description, username, secret
  ))
}

%{ if github_push_token != "" }
upsertCredential(
  "github-push",
  "GitHub push credential for CI tag-bump commits to platform-gitops",
  "${github_push_username}",
  "${github_push_token}"
)
%{ endif }

%{ if dockerhub_token != "" }
upsertCredential(
  "dockerhub",
  "Docker Hub credential for CI image pushes (docker.io/${dockerhub_username})",
  "${dockerhub_username}",
  "${dockerhub_token}"
)
%{ endif }
