apiVersion: v1
kind: Service
metadata:
  name: rabbitmq
  namespace: ${namespace}
spec:
  clusterIP: None
  selector:
    app.kubernetes.io/name: rabbitmq
  ports:
    - name: amqp
      port: 5672
    - name: management
      port: 15672
    - name: prometheus
      port: 15692
---
# rabbitmq:3-management-alpine already enables rabbitmq_management by
# default (baked into the image) -- this ConfigMap adds rabbitmq_prometheus
# alongside it, not instead of it. Gives rabbitmq_queue_messages_ready/
# _unacked per queue directly on :15692, no separate exporter container.
apiVersion: v1
kind: ConfigMap
metadata:
  name: rabbitmq-enabled-plugins
  namespace: ${namespace}
data:
  enabled_plugins: "[rabbitmq_management,rabbitmq_prometheus]."
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: rabbitmq
  namespace: ${namespace}
spec:
  serviceName: rabbitmq
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: rabbitmq
  template:
    metadata:
      labels:
        app.kubernetes.io/name: rabbitmq
      annotations:
        # Same annotation-based discovery as the nest-service chart's
        # metrics pods -- picked up by Prometheus's default kubernetes-pods
        # scrape job (in-cluster only -- see kube_state_metrics_app_services
        # / prometheus remote scrape config for why this alone isn't enough
        # once Prometheus lives on a different cluster).
        prometheus.io/scrape: "true"
        prometheus.io/port: "15692"
        prometheus.io/path: "/metrics"
    spec:
      containers:
        - name: rabbitmq
          image: ${rabbitmq_image}
          ports:
            - containerPort: 5672
            - containerPort: 15672
            - containerPort: 15692
          env:
            - name: RABBITMQ_DEFAULT_USER
              value: notification
            - name: RABBITMQ_DEFAULT_PASS
              valueFrom:
                secretKeyRef:
                  name: app-secrets
                  key: RABBITMQ_PASSWORD
            # Confirmed live: with no container resources set at all, the
            # Erlang VM detects the full host's logical processor count (8
            # on this Mac, not anything scoped to the pod) and starts one
            # busy-waiting scheduler per core -- Erlang schedulers spin
            # rather than sleep by default, specifically to minimize
            # latency, which cost ~83% CPU by itself on an otherwise
            # near-idle broker. The resources block below should already
            # get modern Erlang/OTP to auto-detect the cgroup CPU quota and
            # scale schedulers down accordingly, but pinning it explicitly
            # here doesn't depend on that auto-detection actually working
            # correctly in this image/OTP version -- belt and suspenders.
            - name: RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS
              value: "+S 2:2"
          resources:
            requests: { cpu: 100m, memory: 256Mi }
            limits: { cpu: 500m, memory: 512Mi }
          volumeMounts:
            - name: data
              mountPath: /var/lib/rabbitmq
            - name: enabled-plugins
              mountPath: /etc/rabbitmq/enabled_plugins
              subPath: enabled_plugins
          readinessProbe:
            exec:
              command: ["rabbitmq-diagnostics", "ping"]
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 10
            failureThreshold: 6
          livenessProbe:
            exec:
              command: ["rabbitmq-diagnostics", "ping"]
            initialDelaySeconds: 20
            periodSeconds: 20
            timeoutSeconds: 10
            failureThreshold: 6
      volumes:
        - name: enabled-plugins
          configMap:
            name: rabbitmq-enabled-plugins
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
%{ if storage_class_name != "" ~}
        storageClassName: ${storage_class_name}
%{ endif ~}
        resources:
          requests:
            storage: ${storage_size}
